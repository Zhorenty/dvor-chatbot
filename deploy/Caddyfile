{$MINIAPP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy dvor-api:8080
	}

	handle {
		root * /srv/miniapp
		try_files {path} /index.html
		file_server

		# Flutter file names are not content-hashed: revalidate the entry points.
		@entry path / /index.html /flutter_bootstrap.js /main.dart.js /main.dart.mjs /main.dart.wasm /manifest.json /version.json
		header @entry Cache-Control "no-cache"
		@parts path *.part.js
		header @parts Cache-Control "no-cache"
		@static path /canvaskit/* /assets/* /icons/*
		header @static Cache-Control "public, max-age=604800"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
